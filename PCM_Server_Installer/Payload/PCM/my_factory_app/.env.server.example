# Security
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0

# Upload limit (MB)
MAX_UPLOAD_MB=15

# Optional public base URL used in email links
# APP_BASE_URL=http://192.168.1.100:5000

# SMTP (optional but recommended if using email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Optional defaults for GA request email fallback
GA_RECIPIENTS_DEFAULT=
GA_RECIPIENTS_GA_PC1=
GA_RECIPIENTS_GA_CC=
GA_RECIPIENTS_IT_PC1=
GA_RECIPIENTS_IT_CC=
GA_RECIPIENTS_SAFETY_PC1=
GA_RECIPIENTS_SAFETY_CC=
